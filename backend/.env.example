# Database (Supabase)
# DATABASE_URL = Connection pooler URL (for runtime)
# DIRECT_URL = Direct connection URL (for migrations)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase Auth
# SUPABASE_URL = Project URL (Settings > API)
# SUPABASE_SERVICE_ROLE_KEY = Service role key (Settings > API > service_role)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# CORS
# FRONTEND_URL = URL of the frontend for CORS configuration
FRONTEND_URL=http://localhost:5173

# AI Suggestions (LangChain)
# ANTHROPIC_API_KEY = API key for Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Bank sync — Enable Banking
# Every user configures their own application from Settings > Comptes (App
# ID + a .pem upload) — there is no server-wide default to fall back to; a
# user with nothing configured of their own simply cannot sync yet.
#
# CREDENTIALS_ENCRYPTION_KEY = 32 random bytes, base64-encoded, used to
#   encrypt every user's Enable Banking private key at rest. Generate one
#   with: openssl rand -base64 32
#   Required as soon as any user saves their own credentials; losing this
#   key makes every stored credential unrecoverable, so back it up like any
#   other secret.
CREDENTIALS_ENCRYPTION_KEY=
#
# ENABLE_BANKING_APP_ID / ENABLE_BANKING_PRIVATE_KEY_PATH are read only by
#   the standalone operator scripts (src/scripts/probe-enable-banking.ts,
#   spike-enable-banking-fetch.ts) via this file loaded through dotenv —
#   never by the running server. Set them here only if you use those scripts.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=

# BANK_SYNC_MIN_INTERVAL_HOURS = override the 8h minimum gap between two
# syncs of the same connection (set to 0 while testing locally). Leave unset
# in production. The bank's own daily quota still applies regardless.
BANK_SYNC_MIN_INTERVAL_HOURS=
