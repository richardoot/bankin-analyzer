{
  "name": "backend",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "volta": {
    "extends": "../package.json"
  },
  "version": "0.0.0",
  "scripts": {
    "build": "nest build",
    "build:vercel": "pnpm prisma:generate && pnpm prisma:deploy && pnpm build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "prisma:generate": "prisma generate --config prisma/prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma/prisma.config.ts",
    "prisma:deploy": "prisma migrate deploy --config prisma/prisma.config.ts",
    "prisma:studio": "prisma studio --config prisma/prisma.config.ts",
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@langchain/anthropic": "1.5.10",
    "@langchain/core": "1.2.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "6.7.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/supabase-js": "2.116.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.1",
    "helmet": "8.3.0",
    "langchain": "1.5.11",
    "pg": "8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@prisma/dev": "0.25.2",
    "@swc/core": "1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.1",
    "decimal.js": "10.6.0",
    "eslint": "10.11.0",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "7.2.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "unplugin-swc": "1.6.0",
    "vite": "8.3.0",
    "vitest": "^5.0.1"
  }
}
