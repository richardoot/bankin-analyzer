{
  "buildCommand": "npx pnpm@$(node -p 'require(\"../package.json\").packageManager.slice(5)') build:vercel",
  "installCommand": "npx pnpm@$(node -p 'require(\"../package.json\").packageManager.slice(5)') install",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/bank-sync/scheduled-run",
      "schedule": "30 4 * * *"
    }
  ]
}
