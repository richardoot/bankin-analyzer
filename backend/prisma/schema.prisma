generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

model User {
  id         String   @id @default(uuid())
  supabaseId String   @unique @map("supabase_id")
  email      String   @unique
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  accounts              Account[]
  transactions          Transaction[]
  categories            Category[]
  subcategories         Subcategory[]
  filterPreferences     FilterPreferences?
  persons               Person[]
  reimbursementRequests ReimbursementRequest[]
  importHistories       ImportHistory[]
  settlements           Settlement[]
  budgetPlans           BudgetPlan[]
  tags                  Tag[]
  reimbursementPayments ReimbursementPayment[]
  bankSyncRuns          BankSyncRun[]
  bankStagedTransactions BankStagedTransaction[]
  bankConnections       BankConnection[]
  bankAccountLinks      BankAccountLink[]
  bankAuthorizationAttempts BankAuthorizationAttempt[]
  accountAliases        AccountAlias[]
  enableBankingCredential EnableBankingCredential?

  @@map("users")
  @@schema("app")
}

model Transaction {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  accountId       String          @map("account_id")
  categoryId      String?         @map("category_id")
  subcategoryId   String?         @map("subcategory_id")
  importHistoryId String?         @map("import_history_id")
  hash            String          @unique
  date            DateTime
  description     String
  amount          Decimal         @db.Decimal(12, 2)
  type            TransactionType
  subcategory     String?         // Kept for backward compatibility
  note            String?
  isPointed       Boolean         @default(false) @map("is_pointed")

  /// Where the row came from. Defaults to BANKIN_CSV because that is where
  /// every row predating the bank sync came from, which is what makes the
  /// backfill a default rather than an UPDATE over the whole table.
  source TransactionSource @default(BANKIN_CSV)

  /// The bank's own identifier for the transaction (`entry_reference`), null
  /// for anything imported from a CSV.
  ///
  /// The API describes it as unique and immutable across authentication
  /// sessions, which is the stable identity `hash` never had — the hash is
  /// derived from date, amount and description, all of which a bank may
  /// restate when a transaction settles.
  ///
  /// Unique per account, never globally: the API says the same reference is
  /// likely to reappear on a different account, and phase 2 confirmed it.
  externalId String? @map("external_id")

  /// The bank's settlement status, ISO 20022: BOOK for an accounted
  /// transaction, PDNG for one still pending. Null for CSV rows, which say
  /// nothing on the subject.
  bookingStatus String? @map("booking_status")

  /// Which run last wrote to this row through the bank sync — inserted it, or
  /// claimed it. Null for a row a sync has never touched.
  ///
  /// A CSV import records `importHistoryId` for the same reason: knowing what
  /// wrote a row is what makes undoing it possible without guessing. Update it
  /// only on an actual write; a row a later fetch merely re-recognises
  /// (`alreadyLinked`) keeps the run that originally touched it, so undoing
  /// that earlier run still finds it.
  syncRunId String? @map("sync_run_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountRef            Account                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category              Category?              @relation(fields: [categoryId], references: [id])
  subcategoryRef        Subcategory?           @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  importHistory         ImportHistory?         @relation(fields: [importHistoryId], references: [id], onDelete: SetNull)
  syncRun               BankSyncRun?           @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  reimbursementRequests ReimbursementRequest[]
  settlementsAsIncome   Settlement[]           @relation("SettlementIncome")
  tags                  TransactionTag[]
  reimbursementPayments ReimbursementPayment[] @relation("ReimbursementPaymentIncome")

  /// One bank reference may only be filed once per account. Postgres treats
  /// NULLs as distinct in a unique index, so the CSV rows — all of which have
  /// no reference — are untouched by this and never collide with each other.
  ///
  /// It does NOT make double counting impossible. Phase 2 found Boursorama
  /// reporting one card purchase on both the card account and the current
  /// account it settles onto, with a different reference on each side: two
  /// rows this constraint considers perfectly legitimate. Catching that needs
  /// a rule that compares across accounts, on the event rather than the
  /// reference.
  @@unique([accountId, externalId])
  @@index([userId])
  @@index([accountId])
  @@index([subcategoryId])
  @@index([userId, date])
  @@index([type])
  @@index([importHistoryId])
  @@index([source])
  @@index([syncRunId])
  @@map("transactions")
  @@schema("app")
}

/// Where a transaction came from. The two sources are meant to coexist for
/// good: the API reaches back only as far as each bank allows — 185 days at
/// CIC, 729 at Boursorama — so the CSV export stays the only way to hold
/// anything older.
enum TransactionSource {
  /// Imported from a Bankin' CSV export.
  BANKIN_CSV
  /// Fetched from the bank through the aggregation API.
  BANK_API

  @@schema("app")
}

model Category {
  id                   String          @id @default(uuid())
  userId               String          @map("user_id")
  name                 String
  type                 TransactionType
  icon                 String?
  isExcludedFromBudget Boolean         @default(false) @map("is_excluded_from_budget")
  createdAt            DateTime        @default(now()) @map("created_at")

  user                        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions                Transaction[]
  subcategories               Subcategory[]
  budgetPlanEntries           BudgetPlanEntry[]

  @@unique([userId, name, type])
  @@map("categories")
  @@schema("app")
}

model Subcategory {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  categoryId String   @map("category_id")
  name       String
  icon       String?
  createdAt  DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([categoryId, name])
  @@index([userId])
  @@index([categoryId])
  @@map("subcategories")
  @@schema("app")
}

enum TransactionType {
  EXPENSE
  INCOME

  @@schema("app")
}

enum AccountType {
  STANDARD   // Compte courant/épargne normal
  JOINT      // Compte joint (montants ÷2)
  INVESTMENT // Compte investissement (règles spéciales)

  @@schema("app")
}

/// The reading of a debt against its ledger. No column stores it since phase 6
/// — `derivedStatusOf` computes it — but it remains the vocabulary the API and
/// the frontend share.
enum ReimbursementStatus {
  PENDING
  PARTIAL
  COMPLETED

  @@schema("app")
}

enum ImportStatus {
  IN_PROGRESS
  COMPLETED
  FAILED

  @@schema("app")
}

/// How a reimbursement stopped being owed.
enum PaymentKind {
  /// Cash, drawn from a named income transaction.
  CASH
  /// A remainder the user gave up on. Deliberately a payment of its own kind
  /// rather than a flag: forgiving a debt is an event with a date, and it must
  /// be reversible without touching what was actually collected.
  WRITE_OFF

  @@schema("app")
}

/// A bank account, still identified by its name.
///
/// That will not survive the bank sync, and the reason is recorded here rather
/// than discovered again later: Boursorama returns two distinct card accounts
/// both named `Carte Visa Ultim - RICHARD BOILLEY`. Under `@@unique([userId,
/// name])` they are one row, and `upsertByName` — which resolves an account by
/// its name alone — would merge two years of two cards into a single account.
///
/// Phase 4 has to key synced accounts on something the bank owns (IBAN, or the
/// identification hash for a card account that has none) and relax this
/// constraint. Nothing does yet, so nothing changes here.
model Account {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  name      String
  type      AccountType @default(STANDARD)

  // Configuration selon le type
  divisor              Int     @default(1)
  isExcludedFromBudget Boolean @default(false) @map("is_excluded_from_budget")
  isExcludedFromStats  Boolean @default(false) @map("is_excluded_from_stats")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  bankLinks    BankAccountLink[]
  aliases      AccountAlias[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, type])
  @@map("accounts")
  @@schema("app")
}

model FilterPreferences {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  // Hidden categories are stored as Category ids, never as names: a rename
  // must not silently un-hide a category, and two categories of different
  // types may legitimately share a name.
  // Dashboard filters (temporary, also in localStorage)
  hiddenExpenseCategoryIds String[] @default([]) @map("hidden_expense_category_ids")
  hiddenIncomeCategoryIds  String[] @default([]) @map("hidden_income_category_ids")

  // Global hidden categories
  globalHiddenExpenseCategoryIds String[] @default([]) @map("global_hidden_expense_category_ids")
  globalHiddenIncomeCategoryIds  String[] @default([]) @map("global_hidden_income_category_ids")

  // UI state only
  isPanelExpanded Boolean @default(true) @map("is_panel_expanded")

  /// Whether an import adopts the categories written in the file. On by
  /// default, which is how imports have always behaved. Turned off, the file's
  /// filing is ignored and the transactions are placed among the categories
  /// the user already has — nothing new is created either way.
  ///
  /// Filed here rather than in a table of its own: this row is already where
  /// the per-user preferences live, `isPanelExpanded` included, none of which
  /// is a filter either.
  importCategoriesFromFile Boolean @default(true) @map("import_categories_from_file")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // REMOVED: jointAccounts (now in Account.type)
  // REMOVED: categoryAssociations. The table that replaced them is gone too:
  // a refund is now tied to the expense transaction it repays.

  @@map("filter_preferences")
  @@schema("app")
}

model Person {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  email     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reimbursementRequests ReimbursementRequest[]
  settlements           Settlement[]

  @@unique([userId, name])
  @@index([userId])
  @@map("persons")
  @@schema("app")
}

/// A debt: what one person owes on one expense transaction.
///
/// It carries no `amountReceived` and no `status`. Both were columns until
/// phase 6 of the reimbursement rework, kept in step by hand across three code
/// paths that drifted at least once; both are now read off `payments` through
/// `creditedTotal` and `derivedStatusOf`. The API still exposes them — what
/// went away is the second copy, not the notion.
///
/// It carries no category either. The category of the expense being repaid is
/// the transaction's own, so recategorising a transaction can no longer leave
/// a debt filed under something else.
model ReimbursementRequest {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  transactionId String   @map("transaction_id")
  personId      String   @map("person_id")
  amount        Decimal  @db.Decimal(12, 2)
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  person      Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  settlements SettlementReimbursement[]
  payments    ReimbursementPayment[]

  @@index([userId])
  @@index([transactionId])
  @@index([personId])
  @@map("reimbursement_requests")
  @@schema("app")
}

model ImportHistory {
  id String @id @default(uuid())

  userId String @map("user_id")

  // Statut de l'import
  status ImportStatus @default(IN_PROGRESS)

  // Statistiques d'import
  transactionsImported Int @default(0) @map("transactions_imported")
  categoriesCreated    Int @default(0) @map("categories_created")
  duplicatesSkipped    Int @default(0) @map("duplicates_skipped")
  totalInFile          Int @map("total_in_file")

  // Plage de dates des transactions
  dateRangeStart DateTime? @map("date_range_start")
  dateRangeEnd   DateTime? @map("date_range_end")

  // Métadonnées
  fileName String? @map("file_name")

  createdAt DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([status])
  @@map("import_histories")
  @@schema("app")
}

model Settlement {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  personId            String   @map("person_id")
  incomeTransactionId String   @map("income_transaction_id")
  amountUsed          Decimal  @map("amount_used") @db.Decimal(12, 2)
  note                String?
  createdAt           DateTime @default(now()) @map("created_at")

  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  person            Person                    @relation(fields: [personId], references: [id], onDelete: Cascade)
  incomeTransaction Transaction               @relation("SettlementIncome", fields: [incomeTransactionId], references: [id], onDelete: Cascade)
  reimbursements    SettlementReimbursement[]
  payments          ReimbursementPayment[]

  @@index([userId])
  @@index([personId])
  @@index([incomeTransactionId])
  @@map("settlements")
  @@schema("app")
}

model SettlementReimbursement {
  id              String  @id @default(uuid())
  settlementId    String  @map("settlement_id")
  reimbursementId String  @map("reimbursement_id")
  amountSettled   Decimal @map("amount_settled") @db.Decimal(12, 2)

  settlement    Settlement           @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  reimbursement ReimbursementRequest @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)

  @@unique([settlementId, reimbursementId])
  @@index([reimbursementId])
  @@map("settlement_reimbursements")
  @@schema("app")
}

/// One movement crediting a reimbursement: cash received, or a remainder
/// written off. Together these form the ledger that will replace
/// `ReimbursementRequest.amountReceived` and `status`, both of which become
/// derivable sums rather than counters three code paths keep in step by hand.
///
/// Phase 2 of the rework only *fills* this table — the backfill in the
/// migration mirrors every settlement row — so nothing reads it yet and it can
/// be dropped without consequence. Reconciling it against the columns it will
/// replace is the job of `scripts/reconcile-reimbursement-ledger.ts`.
model ReimbursementPayment {
  id     String @id @default(uuid())
  userId String @map("user_id")

  reimbursementId String @map("reimbursement_id")

  /// The income transaction the money came from. Null only for a WRITE_OFF,
  /// which by definition has no cash behind it — and, transitionally, for a
  /// credit recorded before settlements existed, which named no transaction.
  incomeTransactionId String? @map("income_transaction_id")

  amount Decimal     @db.Decimal(12, 2)
  kind   PaymentKind

  /// When the credit was applied — the settlement's own timestamp, not the
  /// income transaction's date. The two differ and the distinction matters:
  /// one is when the user recorded it, the other when the bank moved it.
  settledAt DateTime @map("settled_at")

  /// The settlement this payment was recorded through, kept so the UI can
  /// still say "this transfer closed these four lines". Null for a credit that
  /// never went through one.
  settlementId String? @map("settlement_id")

  createdAt DateTime @default(now()) @map("created_at")

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  reimbursement     ReimbursementRequest @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  incomeTransaction Transaction?         @relation("ReimbursementPaymentIncome", fields: [incomeTransactionId], references: [id], onDelete: Cascade)
  settlement        Settlement?          @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reimbursementId])
  @@index([incomeTransactionId])
  @@index([settlementId])
  @@map("reimbursement_payments")
  @@schema("app")
}

/// A budget plan: a named, time-bounded budget covering one or more
/// categories. Plans for a single user must not overlap (enforced in service).
/// Both startDate and endDate must align with month boundaries (the 1st of a
/// month and the last day of a month) — also enforced in service.
model BudgetPlan {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  /// Monthly amount the user has decided to set aside (savings, investment).
  /// An input of the plan, not a residual: what is left after it and after the
  /// category envelopes is the budget available for one-off projects.
  savingsTarget Decimal? @map("savings_target") @db.Decimal(12, 2)

  /// Monthly income assumed when the plan was drawn up. Frozen on purpose:
  /// recomputing the project reserve from today's income would silently move a
  /// figure the user decided once, and hide the drift instead of showing it.
  referenceIncome Decimal? @map("reference_income") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries BudgetPlanEntry[]

  @@index([userId])
  @@index([userId, startDate, endDate])
  @@map("budget_plans")
  @@schema("app")
}

/// One amount per category inside a budget plan.
model BudgetPlanEntry {
  id           String  @id @default(uuid())
  budgetPlanId String  @map("budget_plan_id")
  categoryId   String  @map("category_id")
  amount       Decimal @db.Decimal(12, 2)

  budgetPlan BudgetPlan @relation(fields: [budgetPlanId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetPlanId, categoryId])
  @@index([budgetPlanId])
  @@index([categoryId])
  @@map("budget_plan_entries")
  @@schema("app")
}

/// A user-defined label used to group transactions around a theme, event or
/// trip (e.g. "Vacances Italie", "Anniversaire Marie"). A transaction can carry
/// several tags (many-to-many via TransactionTag), enabling per-tag analysis.
model Tag {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  color     String?
  icon      String?

  /// When true, the tagged transactions are kept out of the "everyday"
  /// averages of the dashboard: they describe a one-off event (holiday,
  /// birthday, competition) rather than the user's recurring lifestyle.
  isExceptional Boolean @default(false) @map("is_exceptional")

  /// Optional window during which everyday life is *suspended* (a trip: the
  /// user is away and does not buy groceries, fuel…). When set, those days are
  /// removed from the denominator of everyday averages and the category
  /// baseline is deducted from the event's surplus. When absent, the event is
  /// considered additive (a party at home) and nothing is deducted.
  eventStartDate DateTime? @map("event_start_date") @db.Date
  eventEndDate   DateTime? @map("event_end_date") @db.Date

  /// Total budget allocated to this event — an envelope for the whole project,
  /// never a monthly amount: a trip is decided once, not every month. Charged
  /// against the plan's project reserve (BudgetPlan.savingsTarget).
  budgetAmount Decimal? @map("budget_amount") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
  @@schema("app")
}

/// Join table linking a Tag to a Transaction (many-to-many).
model TransactionTag {
  transactionId String   @map("transaction_id")
  tagId         String   @map("tag_id")
  createdAt     DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
  @@map("transaction_tags")
  @@schema("app")
}

/// One pass of fetching a bank, kept so the matcher can be re-run without
/// asking the bank again.
///
/// That is not a convenience: most ASPSPs allow four background fetches a day,
/// so re-fetching to try a different matching rule is not an option. What was
/// fetched is staged, and the rules are then argued with offline.
model BankSyncRun {
  id     String @id @default(uuid())
  userId String @map("user_id")

  /// The bank, as `GET /aspsps` names it.
  aspspName String @map("aspsp_name")

  /// The Enable Banking session this came from, for tracing a run back to the
  /// authorization that allowed it. Not a credential: it grants nothing on its
  /// own and expires with the consent.
  sessionId String? @map("session_id")

  /// When the bank was asked — distinct from `createdAt`, which is when the
  /// row was written, and from the transactions' own dates.
  fetchedAt DateTime @map("fetched_at")

  createdAt DateTime @default(now()) @map("created_at")

  /// Set once this run has been undone: an inserted row deleted, a claimed
  /// one unlinked. Distinguishes "undone" from "touched nothing" — both
  /// leave no `Transaction` still pointing at this run — and is what a
  /// second undo attempt is refused on.
  undoneAt DateTime? @map("undone_at")

  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions        BankStagedTransaction[]
  writtenTransactions Transaction[]

  @@index([userId])
  @@index([userId, fetchedAt])
  @@map("bank_sync_runs")
  @@schema("app")
}

/// A transaction as the bank sent it, before anything decides what to do with
/// it.
///
/// Staged rather than written straight into `transactions` because the
/// decision is the hard part and it is reversible only while nothing has been
/// written: `transactions` is what reimbursements, settlements, tags and
/// budgets all hang off, and a duplicate there is not a display bug.
model BankStagedTransaction {
  id     String @id @default(uuid())
  runId  String @map("run_id")
  userId String @map("user_id")

  /// The bank's account identifier, and its label at fetch time. The label is
  /// stored rather than looked up because it is not unique — Boursorama
  /// returns two distinct card accounts sharing a name — so it is a hint for a
  /// human, never a key.
  externalAccountId String @map("external_account_id")
  accountName       String @map("account_name")

  /// `entry_reference`. Nullable because the API allows a bank to omit it,
  /// though none of the three measured in phase 2 ever did.
  externalId String? @map("external_id")

  /// ISO 20022 settlement status: BOOK, PDNG…
  bookingStatus String? @map("booking_status")

  /// Day precision, deliberately. Storing a timestamp reintroduces the
  /// midnight-in-Paris drift the import already had to be repaired for, and a
  /// booking date has no time of day to begin with.
  date DateTime @db.Date

  amount Decimal @db.Decimal(12, 2)
  label  String

  /// The untouched payload. What the matcher ignores today may be exactly what
  /// it needs tomorrow, and the bank will not serve this window again.
  raw Json

  createdAt DateTime @default(now()) @map("created_at")

  run  BankSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A run holds one row per bank reference per account. Re-staging the same
  /// fetch is then an upsert rather than a second copy.
  @@unique([runId, externalAccountId, externalId], map: "bank_staged_transactions_identity_key")
  @@index([userId])
  @@index([runId])
  @@index([userId, date])
  @@map("bank_staged_transactions")
  @@schema("app")
}

/// Whether a bank connection can still be used.
enum BankConnectionStatus {
  ACTIVE
  /// The consent lapsed. Banks grant at most 180 days, so this is a normal
  /// end of life rather than a failure, and it needs the user in front of a
  /// browser to renew — nothing the scheduler can do on its own.
  EXPIRED
  /// Withdrawn by the user, here or at the bank.
  REVOKED

  @@schema("app")
}

/// One authorised link to one bank.
model BankConnection {
  id     String @id @default(uuid())
  userId String @map("user_id")

  /// Set from `BankAuthorizationAttempt` when completing an authorization —
  /// the name and country this application itself asked for at `POST /auth`,
  /// from `GET /aspsps` — never from `session.aspsp`, which is the bank's own
  /// echo and is not guaranteed to repeat itself: a duplicate connection was
  /// observed for real after it did not. Falls back to the session's echo
  /// only when no attempt correlates (state missing or expired).
  aspspName    String @map("aspsp_name")
  aspspCountry String @map("aspsp_country")

  /// The Enable Banking session. Expires with the consent and grants nothing
  /// on its own, so it is an identifier to trace a fetch back with, not a
  /// credential to protect.
  sessionId String? @map("session_id")

  /// When the bank stops answering. Stored so the user can be warned before
  /// the sync goes quiet rather than after.
  consentValidUntil DateTime? @map("consent_valid_until")

  status     BankConnectionStatus @default(ACTIVE)
  lastSyncAt DateTime?            @map("last_sync_at")

  /// Set when the bank refused for quota reasons. Until it passes, asking
  /// again only earns another refusal and spends one of the day's few
  /// permitted requests doing it.
  retryAfter DateTime? @map("retry_after")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountLinks BankAccountLink[]

  /// A backstop, not the fix itself: the fix is `completeAuthorization`
  /// trusting the name it asked with over the one the session echoes. This
  /// only turns a would-be duplicate into a loud error rather than silence.
  @@unique([userId, aspspCountry, aspspName])
  @@index([userId])
  @@index([userId, status])
  @@map("bank_connections")
  @@schema("app")
}

/// A `POST /auth` in flight, waiting for the user to come back.
///
/// `startAuthorization` resolves the bank against `GET /aspsps` and asks with
/// that exact name; `completeAuthorization` only sees whatever `session.aspsp`
/// echoes back, which is not guaranteed to be the same string — and once,
/// for real, it was not, so the lookup by name missed and a second connection
/// was created for a bank already connected. This is the canonical name
/// carried across that gap, addressed by `state`: the one value already
/// threaded through the whole redirect, sent to `POST /auth` and echoed back
/// by the bank alongside `code`.
///
/// This does not contradict "nothing is recorded until they come back with a
/// code" (see `BankSyncController.start`) — that promise is about
/// `BankConnection`, the record a person can see on the banks screen. This
/// holds no bank data, only a name a country and whose attempt it was, and an
/// abandoned one is exactly as harmless as a CSRF token nobody redeemed.
model BankAuthorizationAttempt {
  /// The `state` sent to, and echoed back by, Enable Banking.
  id String @id

  userId String @map("user_id")

  aspspName    String @map("aspsp_name")
  aspspCountry String @map("aspsp_country")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("bank_authorization_attempts")
  @@schema("app")
}

/// One user's own Enable Banking application — the credential every call to
/// Enable Banking signs with, so this user's bank sync answers to their own
/// application rather than whichever one this server's operator registered.
///
/// The private key is the sole credential of an application that reads bank
/// accounts, downloadable exactly once from Enable Banking's own Control
/// Panel, so it is stored encrypted rather than in the clear — the same
/// reasoning `enable-banking.client.ts` already applies to the operator's
/// own key, read from disk on each use rather than held anywhere.
model EnableBankingCredential {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  /// Shown back to this user to confirm which application is active; not a
  /// secret on its own — Enable Banking's own Control Panel already shows it
  /// in plain text.
  applicationId String @map("application_id")

  /// AES-256-GCM ciphertext of the .pem content: a random IV, the GCM auth
  /// tag, and the ciphertext, concatenated and base64-encoded. Never read
  /// back by any endpoint this application exposes.
  encryptedPrivateKey String @map("encrypted_private_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("enable_banking_credentials")
  @@schema("app")
}

/// Which account at the bank corresponds to which account here — and whether
/// anything is taken from it.
///
/// The mapping cannot be inferred from names. Boursorama returns two distinct
/// card accounts both named `Carte Visa Ultim - RICHARD BOILLEY`, and the
/// names here ("Perso Bourso", "CJ Fixe") are the user's own words, which no
/// bank has ever heard. It is established once, deliberately, and kept.
model BankAccountLink {
  id           String @id @default(uuid())
  connectionId String @map("connection_id")
  userId       String @map("user_id")

  /// The account in this application. Null until someone decides which one it
  /// is — an unmapped link is a known bank account nothing is read from yet,
  /// which is a legitimate resting state and not an error.
  accountId String? @map("account_id")

  /// The bank's handle for the account within a session. Refreshed on every
  /// authorization: the durable identity is the IBAN, or the identification
  /// hash for a card account that has none.
  externalAccountId String @map("external_account_id")

  iban               String? 
  identificationHash String? @map("identification_hash")

  /// What the bank calls it, kept to show a human which account is which.
  /// Never a key: two of them arrive identical.
  accountName String @map("account_name")

  /// ISO 20022 account type, from `/accounts/{uid}/details`: `CACC` for a
  /// current account, `CARD` for a card account.
  ///
  /// This is the discriminator the double counting needed. A card account has
  /// no counterpart in the ledger — it reports the same money as the account
  /// it settles onto — and no amount of transaction matching can find that
  /// out, precisely because the two genuinely share their transactions.
  cashAccountType String? @map("cash_account_type")

  /// The bank's own product name (`CAV - BOURSOBANK`, `Carte bancaire à débit
  /// immédiat`). Shown to a human deciding what an account is; never matched
  /// on.
  product String?

  /// Whether transactions are taken from this account. Off by default, and
  /// that default is the defence against double counting: Boursorama reports
  /// a card purchase on both the card account and the current account it
  /// settles onto, so enabling everything a bank offers is precisely the
  /// mistake to avoid.
  isIngested Boolean @default(false) @map("is_ingested")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  connection BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)

  /// Kept as a lookup key still (a link is fetched by it right after this
  /// authorization, before anything durable is known), but no longer trusted
  /// to find a link again on a later one — see `completeAuthorization`.
  @@unique([connectionId, externalAccountId])
  /// The backstop: once `iban`/`identificationHash` are trusted for the
  /// lookup, a real duplicate becomes a loud error rather than silence. NULLs
  /// are distinct in a Postgres unique index, so an account with neither
  /// known yet is never blocked by another in the same state.
  @@unique([connectionId, iban])
  @@unique([connectionId, identificationHash])
  @@index([userId])
  @@index([accountId])
  @@map("bank_account_links")
  @@schema("app")
}

/// A label an import has used for an account.
///
/// The two sources name an account differently and neither name is a key: the
/// export says whatever the user typed into Bankin, the API says whatever the
/// bank calls it, and Boursorama says the same thing for two distinct cards.
/// So the account is the user's — its name theirs to change — and each source
/// keeps its own way of pointing at it. `BankAccountLink` is that pointer for
/// the API; this is the one for the CSV.
///
/// Its absence was a defect older than the sync. `upsertByName` resolved an
/// import by the account name while the settings offered to rename an account:
/// renaming `Perso Bourso` to `Bourso` made the next export — still saying
/// `Perso Bourso` — create a second account, STANDARD with divisor 1, and one
/// real account computed two different ways from then on.
model AccountAlias {
  id        String @id @default(uuid())
  userId    String @map("user_id")
  accountId String @map("account_id")

  /// The `Compte` column of an export, verbatim.
  label String

  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// One label resolves to exactly one account. Two accounts claiming the same
  /// export column is the ambiguity this table exists to prevent.
  @@unique([userId, label])
  @@index([accountId])
  @@map("account_aliases")
  @@schema("app")
}
