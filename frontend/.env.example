# Supabase Configuration
# Get these values from your Supabase project settings
# https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_anon_key

# Backend API URL
VITE_API_URL=http://localhost:3000

# Sentry (errors and tracing). Leave VITE_SENTRY_DSN empty to keep the SDK
# out entirely, which is the default at a desk.
# VITE_SENTRY_DSN = the frontend project's DSN (Sentry > Settings > Client Keys).
# VITE_SENTRY_TRACES_SAMPLE_RATE = share of page loads and navigations
#   traced, 0 to 1. Default 1 (everything).
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=

# Source map upload, build time only — set these on Vercel, never here.
# SENTRY_AUTH_TOKEN = an organisation token with the project:releases scope.
# SENTRY_ORG / SENTRY_PROJECT = the Sentry organisation and project slugs.
