{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    // Type-checking only: `--build` walks these projects, and nothing here
    // consumes another's declarations, so there is no output to produce.
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
